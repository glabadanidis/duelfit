{
  "expo": {
    "name": "DuelFit",
    "slug": "duelfit",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.duelfit.app",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#121212"
      },
      "package": "com.duelfit.app"
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#FF5722"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "DuelFit uses your photos so you can upload proof that you completed a forfeit and set your profile photo.",
          "cameraPermission": "DuelFit uses your camera so you can take a photo or video as proof that you completed a forfeit.",
          "microphonePermission": "DuelFit uses your microphone to record sound when you film a video as proof of a forfeit."
        }
      ],
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#121212"
        }
      ]
    ],
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "b735e07d-b072-45f8-815d-b4aa294a2852"
      }
    },
    "owner": "glabadanidis"
  }
}
